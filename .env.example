# ==========================================
# Production Site Configuration & Technical SEO
# ==========================================
NEXT_PUBLIC_SITE_URL=https://portfolio-soumma.vercel.app

# ==========================================
# SMTP Emailer Configuration (Nodemailer)
# ==========================================
# For Gmail:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password under Security -> App Passwords
# 3. Fill in SMTP_USER and SMTP_PASS below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=soummachakraborty.eng@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Recipient Address where portfolio inquiries and automation alerts will be delivered
CONTACT_RECEIVER_EMAIL=soummachakraborty.eng@gmail.com

# ==========================================
# Threads -> Blogger Automation Configuration
# ==========================================

# 1. Meta Threads API
# Get long-lived User Token from Meta for Developers (Threads Graph API)
THREADS_ACCESS_TOKEN=your_meta_threads_user_access_token_here
THREADS_USER_ID=me

# 2. Google Gemini API (Content Expansion & Multimodal Vision)
# Get key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Google Blogger API v3
# Blogger Blog ID found in Blogger URL (e.g. blogger.com/blog/posts/8472910...)
BLOGGER_BLOG_ID=your_blogger_blog_id_here
BLOGGER_API_KEY=your_google_cloud_api_key_here

# Blogger OAuth2 Authentication (Required for creating posts via Blogger v3)
# Option A: Direct OAuth2 Bearer Access Token (valid for 1 hour)
BLOGGER_ACCESS_TOKEN=your_oauth2_access_token_here

# Option B: Automatic Token Refresh (Recommended for hands-free automation)
# Create OAuth 2.0 Client ID with scope 'https://www.googleapis.com/auth/blogger'
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token_here

# 4. Telegram Notification Alerts (Optional)
# Create a bot with @BotFather on Telegram to get token, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id_here

# 5. Route Protection Secret (Optional for cron triggers / webhooks)
AUTOMATION_SECRET_TOKEN=your_secret_cron_passphrase_here
